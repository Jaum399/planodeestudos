# Variáveis de ambiente para produção no Vercel
# Configure estas variáveis no painel do Vercel: Settings > Environment Variables

# OBRIGATÓRIO: Chave secreta para assinar os tokens JWT
# Gere uma chave forte com: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=sua_chave_secreta_muito_forte_aqui

# Duração do token JWT (ex: 7d, 30d, 1h)
JWT_EXPIRES_IN=7d

# E-mail remetente para envios automáticos e recuperação de senha
EMAIL_USER=entcenologia@gmail.com
EMAIL_PASS=sua_senha_de_app_do_gmail
EMAIL_FROM_NAME=AppMentoria

# Modo demo de pagamento: ativa o plano imediatamente sem gateway real
# true  = ativa o plano ao clicar em "Assinar" (para testes)
# false = exige integração com gateway real (Stripe, Mercado Pago, etc.)
PAYMENT_DEMO_MODE=true

# Porta (Vercel define automaticamente, não precisa configurar)
# PORT=3001
